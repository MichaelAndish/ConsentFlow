{
  "name": "consentflow",
  "private": true,
  "version": "1.0.0",
  "description": "ConsentFlow — BSPHO paediatric ICF workbench (Hack for Good / Google Belgium demo)",
  "license": "MIT",
  "author": "Michael Andish",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelAndish/ConsentFlow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=1110 --host=0.0.0.0",
    "start": "node server.js",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=server.js --packages=external",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist .vite",
    "lint": "tsc --noEmit",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test src/utils/studyLogic.test.ts src/services/cloudBucketService.test.ts src/services/geminiService.test.ts src/services/geminiServer.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
