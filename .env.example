# ==============================================================================
# ConsentFlow — environment template (copy to .env — never commit .env)
# ==============================================================================

# Google Gemini (server-only — never exposed to the browser bundle)
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional: require X-Seed-Token on POST /api/seed (recommended for public Cloud Run)
SEED_SECRET=""

# ==============================================================================
# Google Cloud Platform (set after you create / receive a project)
# ==============================================================================
# Multi-account machines: pin the account email used by `make auth`
# Example placeholder: student-01-xxxx@qwiklabs.net
GOOGLE_CLOUD_ACCOUNT=""
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_REGION="europe-west1"
GCS_DEFAULT_BUCKET="your-gcs-bucket-name"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_BUCKET_URI="gs://your-gcs-bucket-name/"
GCS_LOCATION="europe-west1 (Belgium)"
GCS_STORAGE_CLASS="STANDARD"
GCS_PUBLIC_ACCESS="Not public"
GCS_PROTECTION="Soft Delete"

# Optional demo folder labels (sample only)
GCS_FOLDER_BIOMEDE="Biomede Example/"
GCS_FOLDER_FORUM="Forum Example/"
GCS_FOLDER_HEM_ISMART="HEM-iSmart Example/"
GCS_FOLDER_NATIONAL_TEMPLATES="National Templates/"
GCS_FOLDER_ADDITIONAL_MATERIALS="Additional Materials/"
GCS_FOLDER_PEDIATRIC_PRESCRIBER="Pediatric Prescriber/"

# ==============================================================================
# Application URL & Port
# ==============================================================================
ENV_URL="http://localhost:1110"
APP_URL="http://localhost:1110"
PORT=1110
HOST="0.0.0.0"

# Local Docker Postgres only (demo credentials — not for production)
DATABASE_URL="postgresql://consentflow:consentflow_secret@localhost:5432/consentflow_db"
